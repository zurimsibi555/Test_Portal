# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional WebRTC TURN Relay (supports comma-separated UDP + TCP/443 URLs for mobile 4G/5G CGNAT)
# Example: NEXT_PUBLIC_TURN_URL=turn:host:80,turn:host:443?transport=tcp
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Admin Access Credentials
ADMIN_SECRET_KEY=teacher123

# Piston Code Execution API (Free public endpoint)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
